# Copy to .env (chmod 600) and fill in. Never commit the real file.

# --- paperless-organize ---
PAPERLESS_API_URL=http://127.0.0.1:8000/api
PAPERLESS_TOKEN=changeme-paperless-api-token
AI_BIN=claude
AI_MODEL=sonnet
# AI_WORKDIR=/home/youruser
# Optional notifications
# NTFY_URL=http://127.0.0.1:2586/your-topic
# PAPERLESS_UI_URL=http://paperless.example.lan

# --- server-api ---
SERVER_API_HOST=127.0.0.1
SERVER_API_PORT=11435
NETALERTX_URL=http://127.0.0.1:20212/graphql
NETALERTX_TOKEN=changeme-netalertx-token
# Optional script printing who is home (used by /presence)
# PRESENCE_CMD=/path/to/presence.py --status
# Comma-separated systemd units reported by /services
# MONITORED_SERVICES=llama-server,server-api,docker,tailscaled

# --- openwebui-tools (set in the Open WebUI container environment) ---
SERVER_API_BASE=http://host.docker.internal:11435
LINUX_OPS_API_BASE=http://host.docker.internal:11436
# Services the linux_ops tool may restart / read logs of
LINUX_OPS_ALLOWED_SERVICES=llama-server,server-api,linux-ops,docker
